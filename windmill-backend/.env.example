# Windmill backend settings. Copy to .env (make up does it for you).
# One KEY=value a line. Values can't hold # or $, so the secret is hex.
WINDMILL_MONGO_URI=mongodb://localhost:27017/windmill
WINDMILL_LISTEN=127.0.0.1:8080
# Base for media and upload links; unset means the host each request called.
# WINDMILL_PUBLIC_URL=
WINDMILL_BLOB_DIR=windmill-backend/.data/blobs
# 32 bytes or more as hex: openssl rand -hex 32
WINDMILL_BLOB_SECRET=
WINDMILL_DEV_AUTH=1
# make test starts MongoDB itself when this is unset.
# WINDMILL_TEST_MONGO_URI=mongodb://127.0.0.1:27017
# The go binary to use, as an absolute path, when the one on PATH is too old.
# GO=/absolute/path/to/go
# Which Docker context make uses, without switching your current one.
# DOCKER_CONTEXT=colima
